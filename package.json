{
  "name": "culprit-blog",
  "private": true,
  "version": "0.1.0",
  "description": "Code-first engineering blog for Culprit SQL (culpritsql.com/blog), built with Astro, MDX, React 19, and @culpritsql/plan-viewer.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --port 4322",
    "typecheck": "astro check && tsc --noEmit",
    "build": "astro build && node scripts/export-llms-and-manifest.mjs",
    "preview": "astro preview --port 4322",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.4",
    "@astrojs/react": "^4.2.4",
    "@astrojs/rss": "^4.0.11",
    "@culpritsql/plan-viewer": "^0.6.0",
    "@culpritsql/plans": "^0.6.5",
    "astro": "^5.7.10",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
