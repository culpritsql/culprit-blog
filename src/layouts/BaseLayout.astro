---
import "../styles/blog.css";

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath,
  ogType = "website",
  publishedTime,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, "https://culpritsql.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Culprit SQL Blog RSS" href="https://culpritsql.com/blog/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0f0e0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Culprit SQL Studio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://culpritsql.com/og.jpg" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://culpritsql.com/og.jpg" />

    <link rel="icon" href="/blog/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/blog/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script defer src="https://plausible.io/js/pa-r5EkaWqkhpILeZH2bizcF.js"></script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-row">
        <a class="brand" href="https://culpritsql.com/" aria-label="Culprit SQL Studio home">
          <img src="/blog/favicon.svg" width="28" height="28" alt="" />
          <span>Culprit <b>SQL Studio</b></span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="https://culpritsql.com/#findings">Features</a>
          <a href="https://culpritsql.com/#agents">Agents</a>
          <a href="https://culpritsql.com/#engines">Databases</a>
          <a href="https://explain.culpritsql.com">Explain</a>
          <a href="/blog/" class="active">Blog</a>
        </nav>
        <div class="nav-cta">
          <a class="btn ghost" href="https://github.com/culpritsql" rel="noopener">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            <span>GitHub</span>
          </a>
          <a class="btn primary" href="https://culpritsql.com/#download">Download</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap foot-row">
        <a class="brand" href="https://culpritsql.com/">
          <img src="/blog/favicon.svg" width="22" height="22" alt="" />
          <span>Culprit <b>SQL Studio</b></span>
        </a>
        <nav class="foot-nav" aria-label="Footer">
          <a href="/blog/">Blog</a>
          <a href="/blog/rss.xml">RSS</a>
          <a href="https://explain.culpritsql.com">Explain</a>
          <a href="https://github.com/culpritsql/culprit-sql-studio/blob/main/docs/guide.md" rel="noopener">Guide</a>
          <a href="https://github.com/culpritsql/culprit-sql-studio/blob/main/docs/collector.md" rel="noopener">Collector &amp; ADX</a>
          <a href="https://culpritsql.com/llms.txt">llms.txt</a>
          <a href="https://github.com/culpritsql/culprit-blog" rel="noopener">Source</a>
        </nav>
        <span>© 2026 Culprit SQL Studio</span>
      </div>
    </footer>
  </body>
</html>
