---
export interface WorkflowCard {
  step: string;
  when: string;
  tool: string;
  href: string;
  points: string[];
}

export interface Props {
  cards: WorkflowCard[];
}

const { cards } = Astro.props;
---

<div class="blog-wide">
  <div class="ed-workflow-grid">
    {
      cards.map((c) => (
        <article class="ed-workflow-card">
          <div class="ed-workflow-top">
            <span class="ed-workflow-step">{c.step}</span>
            <span class="ed-workflow-when">{c.when}</span>
          </div>
          <h4>
            <a href={c.href} target="_blank" rel="noopener">
              {c.tool} ↗
            </a>
          </h4>
          <ul>
            {c.points.map((pt) => (
              <li set:html={pt} />
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</div>
