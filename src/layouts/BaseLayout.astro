---
import "../styles/blog.css";

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  markdownPath?: string;
  showProgress?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath,
  ogImagePath = "/blog/og.png",
  ogImageAlt = title,
  ogType = "website",
  author = "Culprit Team",
  publishedTime,
  modifiedTime,
  tags = [],
  markdownPath,
  showProgress = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, "https://culpritsql.com").toString();
const ogImageUrl = new URL(ogImagePath, "https://culpritsql.com").toString();
const markdownUrl = markdownPath ? new URL(markdownPath, "https://culpritsql.com").toString() : null;

const LOCALES = [
  { code: "en", hreflang: "en", label: "English", href: "https://culpritsql.com/" },
  { code: "zh", hreflang: "zh-Hans", label: "简体中文", href: "https://culpritsql.com/zh/" },
  { code: "ja", hreflang: "ja", label: "日本語", href: "https://culpritsql.com/ja/" },
  { code: "ko", hreflang: "ko", label: "한국어", href: "https://culpritsql.com/ko/" },
  { code: "ru", hreflang: "ru", label: "Русский", href: "https://culpritsql.com/ru/" },
  { code: "de", hreflang: "de", label: "Deutsch", href: "https://culpritsql.com/de/" },
  { code: "es", hreflang: "es", label: "Español", href: "https://culpritsql.com/es/" },
  { code: "fr", hreflang: "fr", label: "Français", href: "https://culpritsql.com/fr/" },
  { code: "pt", hreflang: "pt-BR", label: "Português", href: "https://culpritsql.com/pt/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Culprit SQL Blog RSS" href="https://culpritsql.com/blog/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Culprit SQL Releases RSS" href="https://culpritsql.com/releases/rss.xml" />
    {markdownUrl && <link rel="alternate" type="text/markdown" title="Markdown version" href={markdownUrl} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0f0e0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Culprit SQL" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && <meta property="article:author" content={author} />}
    {ogType === "article" && <meta property="article:section" content="Database Performance" />}
    {ogType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/blog/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/blog/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("culprit:theme") || localStorage.getItem("culprit-blog:theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.dataset.theme = saved;
          }
        } catch (_) {}
      })();
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script defer src="https://plausible.io/js/pa-r5EkaWqkhpILeZH2bizcF.js"></script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-row">
        <a class="brand" href="https://culpritsql.com/" aria-label="Culprit SQL">
          <img src="/blog/favicon.svg" width="26" height="26" alt="Culprit SQL logo" />
          <span>Culprit <b>SQL</b></span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <details class="nav-dropdown">
            <summary>
              Products
              <svg class="nav-caret" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <div class="nav-panel">
              <a class="nav-prod" href="https://culpritsql.com/studio/">
                <span class="nav-prod-head"><span>Studio &amp; CLI</span><span class="nav-prod-tag">App · CLI · MCP</span></span>
                <p>14 MB native desktop app, JSON/SARIF CLI, and 27-tool local MCP server.</p>
              </a>
              <a class="nav-prod" href="https://culpritsql.com/fleet/">
                <span class="nav-prod-head"><span>Fleet &amp; Collector</span><span class="nav-prod-tag">ADX · ClickHouse</span></span>
                <p>24/7 zero-credential fleet triage over your own ADX or ClickHouse.</p>
              </a>
              <a class="nav-prod" href="https://culpritsql.com/explain/">
                <span class="nav-prod-head"><span>Explain &amp; Wasm</span><span class="nav-prod-tag">Wasm · .xel</span></span>
                <p>Client-side execution plan, diff, deadlock, and .xel workbench.</p>
              </a>
              <a class="nav-prod" href="https://culpritsql.com/ci/">
                <span class="nav-prod-head"><span>CI, IDE &amp; SDKs</span><span class="nav-prod-tag">SARIF · VS Code</span></span>
                <p>Offline PR migration gates, VS Code extension, and test assertions.</p>
              </a>
              <div class="nav-panel-foot">
                <span>100% Open Source · MIT License</span>
                <span><a href="https://fleet.culpritsql.com">Live Fleet demo ↗</a> · <a href="https://explain.culpritsql.com">Open Explain ↗</a></span>
              </div>
            </div>
          </details>
          <a href="https://culpritsql.com/enterprise/">Enterprise</a>
          <a href="https://culpritsql.com/databases/">Databases</a>
          <a href="https://culpritsql.com/releases/">Releases</a>
          <a href="/blog/" class="active">Blog</a>
        </nav>
        <div class="nav-cta">
          <details class="lang-menu">
            <summary aria-label="Language">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
              </svg>
              <span class="lang-full">English</span>
              <svg class="nav-caret" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            <div class="lang-list">
              {
                LOCALES.map((loc) => (
                  <a class={loc.code === "en" ? "lang-item active" : "lang-item"} href={loc.href} hreflang={loc.hreflang}>
                    <span>{loc.label}</span>
                    {loc.code === "en" && <span>✓</span>}
                  </a>
                ))
              }
            </div>
          </details>
          <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle color theme" title="Toggle color theme">
            <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
          <a class="btn ghost hide-xs" href="https://github.com/culpritsql/culprit-sql-studio" rel="noopener">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            <span>GitHub</span>
          </a>
          <a class="btn primary" href="https://culpritsql.com/studio/#download">Get Culprit</a>
          <details class="mobile-menu">
            <summary class="icon-btn" aria-label="Menu">
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
              </svg>
            </summary>
            <div class="mobile-drawer">
              <div class="mobile-drawer-group">Products</div>
              <a href="https://culpritsql.com/studio/"><span>Studio &amp; CLI</span><span class="nav-prod-tag">App · CLI</span></a>
              <a href="https://culpritsql.com/fleet/"><span>Fleet &amp; Collector</span><span class="nav-prod-tag">24/7</span></a>
              <a href="https://culpritsql.com/explain/"><span>Explain &amp; Wasm</span><span class="nav-prod-tag">Wasm</span></a>
              <a href="https://culpritsql.com/ci/"><span>CI, IDE &amp; SDKs</span><span class="nav-prod-tag">SARIF</span></a>
              <div class="mobile-drawer-group">Culprit SQL</div>
              <a href="https://culpritsql.com/enterprise/">Enterprise</a>
              <a href="https://culpritsql.com/databases/">Databases</a>
              <a href="https://culpritsql.com/releases/">Releases</a>
              <a href="/blog/" class="active">Blog</a>
              <a href="https://github.com/culpritsql" rel="noopener">GitHub (@culpritsql) ↗</a>
              <a class="mobile-cta" href="https://culpritsql.com/studio/#download">Get Culprit</a>
            </div>
          </details>
        </div>
      </div>
      {showProgress && <div class="scroll-progress" id="scroll-progress" aria-hidden="true" />}
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <a class="brand" href="https://culpritsql.com/">
              <img src="/blog/favicon.svg" width="24" height="24" alt="Culprit SQL logo" />
              <span>Culprit <b>SQL</b></span>
            </a>
            <p>Deterministic database root-cause engineering across local development, CI pull requests, and 24/7 production fleets. Free and open source under MIT.</p>
          </div>
          <div class="foot-col">
            <h3>Platform</h3>
            <ul>
              <li><a href="https://culpritsql.com/studio/">Studio &amp; CLI</a></li>
              <li><a href="https://culpritsql.com/fleet/">Fleet &amp; Collector</a></li>
              <li><a href="https://culpritsql.com/explain/">Explain &amp; Wasm</a></li>
              <li><a href="https://culpritsql.com/ci/">CI, IDE &amp; SDKs</a></li>
              <li><a href="https://culpritsql.com/enterprise/">Enterprise</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Developers</h3>
            <ul>
              <li><a href="https://fleet.culpritsql.com">fleet.culpritsql.com ↗</a></li>
              <li><a href="https://explain.culpritsql.com">explain.culpritsql.com ↗</a></li>
              <li><a href="https://github.com/culpritsql/culprit-vscode" rel="noopener">VS Code Extension</a></li>
              <li><a href="https://github.com/culpritsql/culprit-ci" rel="noopener">@culpritsql/ci</a></li>
              <li><a href="https://github.com/culpritsql/culprit-plans" rel="noopener">@culpritsql/plans</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Databases</h3>
            <ul>
              <li><a href="https://culpritsql.com/databases/sql-server/">SQL Server &amp; Azure SQL</a></li>
              <li><a href="https://culpritsql.com/databases/postgresql/">PostgreSQL &amp; RDS</a></li>
              <li><a href="https://culpritsql.com/databases/timescaledb/">TimescaleDB</a></li>
              <li><a href="https://culpritsql.com/databases/yugabytedb/">YugabyteDB</a></li>
              <li><a href="https://culpritsql.com/databases/mysql/">MySQL &amp; MariaDB</a></li>
              <li><a href="https://culpritsql.com/databases/clickhouse/">ClickHouse</a></li>
              <li><a href="https://culpritsql.com/databases/sqlite/">SQLite</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h3>Resources</h3>
            <ul>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/blog/rss.xml">Blog RSS</a></li>
              <li><a href="https://culpritsql.com/releases/">Releases</a></li>
              <li><a href="https://culpritsql.com/releases/rss.xml">Releases RSS</a></li>
              <li><a href="https://culpritsql.com/llms.txt">llms.txt</a></li>
              <li><a href="https://github.com/culpritsql/culprit-sql-studio/blob/main/LICENSE" rel="noopener">MIT License</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© 2026 Culprit SQL · Released under the MIT License</span>
          <span><a href="https://github.com/culpritsql" rel="noopener">github.com/culpritsql</a> · <a href="https://culpritsql.com/llms-full.txt">llms-full.txt</a></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (btn) {
          btn.addEventListener("click", function () {
            var root = document.documentElement;
            var current =
              root.dataset.theme ||
              (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            var next = current === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try {
              localStorage.setItem("culprit:theme", next);
              localStorage.setItem("culprit-blog:theme", next);
            } catch (_) {}
          });
        }

        var popovers = Array.prototype.slice.call(
          document.querySelectorAll("details.nav-dropdown, details.lang-menu, details.mobile-menu"),
        );
        document.addEventListener("click", function (e) {
          popovers.forEach(function (d) {
            if (d.open && !d.contains(e.target)) d.open = false;
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            popovers.forEach(function (d) {
              d.open = false;
            });
          }
        });

        var bar = document.getElementById("scroll-progress");
        if (bar) {
          var updateProgress = function () {
            var doc = document.documentElement;
            var max = doc.scrollHeight - doc.clientHeight;
            var pct = max > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / max) * 100)) : 0;
            bar.style.transform = "scaleX(" + pct / 100 + ")";
          };
          window.addEventListener("scroll", updateProgress, { passive: true });
          updateProgress();
        }

        var headings = document.querySelectorAll(".article-prose h2[id], .article-prose h3[id]");
        headings.forEach(function (h) {
          if (h.querySelector(".heading-anchor")) return;
          var a = document.createElement("a");
          a.className = "heading-anchor";
          a.href = "#" + h.id;
          a.setAttribute("aria-label", "Link to section " + (h.textContent || ""));
          a.textContent = "#";
          h.appendChild(a);
        });

        var pres = document.querySelectorAll("pre.astro-code");
        pres.forEach(function (pre) {
          if (pre.parentElement && pre.parentElement.classList.contains("code-frame")) return;
          var lang = (pre.getAttribute("data-language") || "code").toUpperCase();
          var frame = document.createElement("div");
          frame.className = "code-frame";
          var head = document.createElement("div");
          head.className = "code-frame-head";
          var label = document.createElement("span");
          label.className = "code-frame-lang";
          label.textContent = lang;
          var copyBtn = document.createElement("button");
          copyBtn.type = "button";
          copyBtn.className = "code-copy-btn";
          copyBtn.textContent = "Copy";
          copyBtn.addEventListener("click", function () {
            var code = pre.innerText || "";
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(code).then(function () {
                copyBtn.textContent = "Copied";
                copyBtn.classList.add("copied");
                setTimeout(function () {
                  copyBtn.textContent = "Copy";
                  copyBtn.classList.remove("copied");
                }, 1600);
              });
            }
          });
          head.appendChild(label);
          head.appendChild(copyBtn);
          pre.parentNode.insertBefore(frame, pre);
          frame.appendChild(head);
          frame.appendChild(pre);
        });
      })();
    </script>
  </body>
</html>
