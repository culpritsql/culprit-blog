---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": "https://culpritsql.com/blog/#blog",
      name: "Culprit SQL Engineering Blog",
      url: "https://culpritsql.com/blog/",
      inLanguage: "en-US",
      description:
        "Field notes on SQL execution plans, deadlocks, Azure SQL telemetry, and database performance across SQL Server, PostgreSQL, MySQL, and SQLite.",
      publisher: {
        "@type": "Organization",
        name: "Culprit SQL",
        url: "https://culpritsql.com/",
        logo: {
          "@type": "ImageObject",
          url: "https://culpritsql.com/apple-touch-icon.png",
        },
      },
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.seoDescription,
        url: `https://culpritsql.com/blog/${post.id}/`,
        datePublished: post.data.pubDate.toISOString(),
        image: `https://culpritsql.com/blog/${post.id}/og.png`,
        author: {
          "@type": "Organization",
          name: post.data.author,
          url: "https://github.com/culpritsql",
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Culprit SQL", item: "https://culpritsql.com/" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://culpritsql.com/blog/" },
      ],
    },
  ],
};
---

<BaseLayout
  title="SQL Performance & Telemetry Notes | Culprit SQL Blog"
  description="Practical engineering notes on SQL Server .sqlplan diffs, deadlocks, Azure SQL Database Watcher, ADX KQL alerts, and PostgreSQL query tuning."
  canonicalPath="/blog/"
  ogImagePath="/blog/og.png"
  ogImageAlt="Culprit SQL Engineering Notes: Database performance, execution plans, and telemetry"
  jsonLd={jsonLd}
>
  <section class="blog-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="index-wrap">
      <div class="blog-hero-top">
        <p class="blog-kicker"><span class="blog-kicker-dot"></span> Engineering Notes</p>
        <a class="rss-pill" href="/blog/rss.xml">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>RSS</span>
        </a>
      </div>
      <h1>Database performance, plans, and telemetry.</h1>
      <p class="blog-hero-sub">
        Field notes from building Culprit SQL: reading execution plans, untangling lock cycles, and running database telemetry without vendor lock-in.
      </p>

      <div class="filter-bar" role="toolbar" aria-label="Filter posts by topic">
        <button type="button" class="filter-chip active" data-filter="all">All notes ({posts.length})</button>
        {
          allTags.map((tag) => (
            <button type="button" class="filter-chip" data-filter={tag}>
              {tag}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="index-wrap post-list" aria-label="Blog posts">
    {
      posts.map((post, idx) => (
        <a class="post-card" href={`/blog/${post.id}/`} data-tags={post.data.tags.join("|")}>
          <div class="post-card-top">
            <div class="post-card-meta">
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                {formatDate(post.data.pubDate)}
              </time>
              <span class="meta-dot">·</span>
              <span class="read-time">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                {post.data.readingMinutes} min read
              </span>
            </div>
            {idx === 0 && <span class="latest-badge">Latest</span>}
          </div>

          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>

          <div class="post-card-foot">
            <div class="tag-row">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <span class="read-cta">
              Read note <span class="arrow">→</span>
            </span>
          </div>
        </a>
      ))
    }
  </section>

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll(".filter-chip");
      var cards = document.querySelectorAll(".post-card");
      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          var target = chip.getAttribute("data-filter") || "all";
          chips.forEach(function (c) {
            c.classList.toggle("active", c === chip);
          });
          cards.forEach(function (card) {
            var raw = card.getAttribute("data-tags") || "";
            var list = raw ? raw.split("|") : [];
            var show = target === "all" || list.indexOf(target) >= 0;
            card.style.display = show ? "" : "none";
          });
        });
      });
    })();
  </script>
</BaseLayout>
